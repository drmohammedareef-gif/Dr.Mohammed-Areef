rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Car images are publicly readable for showroom visitors
      allow read: if true;
      
      // Admin can upload, update or delete any file
      // Public visitors can upload images up to 10MB during vehicle submission
      allow write: if request.auth != null || 
        (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'));
    }
  }
}
